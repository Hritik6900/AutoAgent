{
  "manifest_version": 3,
  "name": "AutoResearch",
  "version": "1.0.0",
  "description": "Fact-check any claim on any page. Each check is paid for in USDC over x402 and comes back with an on-chain receipt.",
  "permissions": ["contextMenus", "storage", "scripting", "activeTab"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AutoResearch"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
